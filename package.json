{
  "name": "soundcloud-shortcuts",
  "version": "1.2.1",
  "private": true,
  "description": "Keyboard shortcuts for soundcloud.com, remappable in your browser's extension shortcut settings.",
  "author": "James Gentes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgentes/soundcloud-shortcuts.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "assets": "wxt build && node scripts/store-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.6",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wxt": "^0.21.5"
  }
}
